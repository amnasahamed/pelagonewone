# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.

# --- Contact form (pick ONE provider) ---

# Option A: Resend (https://resend.com) — recommended for production
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=info@pelagoconsultants.com
# Use a verified domain in production; onboarding@resend.dev works for testing only.
# CONTACT_FROM_EMAIL=Pelago <hello@yourdomain.com>

# Option B: Web3Forms (https://web3forms.com) — free tier, no card required
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Optional: public site URL for metadata (if you add OG URLs later) ---
# NEXT_PUBLIC_SITE_URL=https://pelagoconsultants.com

# --- Sanity CMS (https://www.sanity.io/manage) ---
# Create a project, then copy Project ID and dataset name (usually "production").
# NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
#
# Write token (Editor) — only for local migration script, NOT for the browser:
# SANITY_API_WRITE_TOKEN=sk...
#
# After setting vars: npm run dev → open http://localhost:3000/studio/
# CORS: add http://localhost:3000 in sanity.io/manage → API → CORS (with credentials)
# Production: also add https://your-domain.com to CORS when deploying
# Import existing posts once: npm run sanity:migrate
